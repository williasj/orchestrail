# Orchestrail Configuration
# Copy this file to .env and fill in your values

# Server
PORT=8080

# Ollama connection (required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# API key for OpenAI-compatible clients (use "ollama" for local Ollama)
OPENAI_API_KEY=ollama

# Persistent data directory (agent configs, tool configs, coordinator prompt)
DATA_DIR=./data
